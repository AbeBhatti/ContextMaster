# ============================================================
# ContextMaster — Environment Variables (template)
# Copy to .env and fill in the values marked  <-- FILL
# ============================================================

# ------------------------------------------------------------
# Redis  (replaces Supabase/Postgres — vector + full-text + KV + streams)
# ------------------------------------------------------------
# Local dev: Docker Redis Stack (docker compose up). Default below works as-is.
REDIS_URL=redis://localhost:6379

# Final demo: Redis Cloud connection string.            <-- FILL (for demo)
# Format: redis://default:<password>@<host>:<port>
REDIS_CLOUD_URL=
USE_REDIS_CLOUD=false

# Logical key namespace + RediSearch index prefix. Leave default.
REDIS_PREFIX=cm

# ------------------------------------------------------------
# OpenAI  (embeddings + extraction + super-commit verification)
# ------------------------------------------------------------
OPENAI_API_KEY=                                          # <-- FILL  (sk-...)
# Only set this to use an OpenAI-compatible gateway. Leave unset for real OpenAI
# (any ambient OPENAI_BASE_URL from your shell is ignored unless set here).
# OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EXTRACTION_MODEL=gpt-4o-mini
SUPER_COMMIT_MODEL=gpt-4o-mini

# ------------------------------------------------------------
# API Server
# ------------------------------------------------------------
PORT=3001
APP_BASE_URL=http://localhost:5173
STORAGE_DIR=./storage

# ------------------------------------------------------------
# Server-side extraction (save_session / commit-raw / Streams worker)
# ------------------------------------------------------------
SERVER_SIDE_EXTRACTION=true

# ------------------------------------------------------------
# MCP Client  (the @contextmaster/mcp-client stdio package)
# ------------------------------------------------------------
CNTXT_API_URL=http://localhost:3001
CNTXT_API_KEY=                                           # <-- FILL  (auto-minted on first seed)

# ------------------------------------------------------------
# Auth (Clerk)  — dashboard + API. Auth is wired in phase 7; keep bypass on.
# ------------------------------------------------------------
AUTH_BYPASS=true
AUTH_BYPASS_EMAIL=test@example.com
AUTH_BYPASS_NAME=Test User
AUTH_BYPASS_CLERK_ID=dev-bypass-user

CLERK_SECRET_KEY=                                        # <-- FILL (if AUTH_BYPASS=false)
CLERK_JWKS_URL=
CLERK_ISSUER=

# ------------------------------------------------------------
# Email delivery (Resend) — workspace invites. Optional.
# ------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=ContextMaster <noreply@localhost>

# ------------------------------------------------------------
# Dashboard (Vite — must be VITE_ prefixed to reach the browser)
# ------------------------------------------------------------
VITE_API_URL=http://localhost:3001
VITE_AUTH_BYPASS=true
VITE_CLERK_PUBLISHABLE_KEY=                              # <-- FILL (if using real Clerk)
