# Dashboard environment variables (Vite — must be prefixed with VITE_)

# API URL — match your API server PORT
VITE_API_URL=http://localhost:3001

# Skip Clerk and use the test user (matches API's AUTH_BYPASS)
VITE_AUTH_BYPASS=true

# Required when VITE_AUTH_BYPASS=false
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
